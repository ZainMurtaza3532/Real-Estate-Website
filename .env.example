# Database URL (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/havenstone?schema=public"

# NextAuth / Auth.js v5 Configuration
# Generate secret using: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Credentials (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudinary Media Storage (https://cloudinary.com/)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Super Administrator Initializer
ADMIN_EMAIL="admin@havenstone.com"
ADMIN_PASSWORD="YourSecureAdminPassword123"
ADMIN_NAME="Super Administrator"

# Brand & Canonical Site Configuration
NEXT_PUBLIC_SITE_NAME="HavenStone Estates"
NEXT_PUBLIC_SITE_URL="https://havenstone.com"
