// Production-Grade Prisma Schema for Multi-Role Real Estate Marketplace
// Database: PostgreSQL (Neon / Supabase / AWS RDS / Self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  COMMERCIAL
  PLOT
  PENTHOUSE
}

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SOLD
}

enum InquiryStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED
}

// ----------------------------------------------------
// USER MODEL
// ----------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  password       String?   // Hashed with bcrypt (cost 12)
  image          String?
  phone          String?
  whatsappNumber String?
  role           Role      @default(BUYER)
  isVerified     Boolean   @default(false)
  agencyName     String?

  // Relations
  properties     Property[] @relation("SellerProperties")
  inquiries      Inquiry[]  @relation("BuyerInquiries")
  leads          Inquiry[]  @relation("SellerInquiries")
  favorites      Favorite[]

  // Auth.js / NextAuth Support
  accounts       Account[]
  sessions       Session[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role, isVerified])
  @@index([email])
}

// ----------------------------------------------------
// PROPERTY MODEL
// ----------------------------------------------------

model Property {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String        @db.Text
  price         Float
  currency      String        @default("USD")
  propertyType  PropertyType
  listingType   ListingType
  listingStatus ListingStatus @default(PENDING_APPROVAL)

  bedrooms      Int           @default(0)
  bathrooms     Int           @default(0)
  areaSqFt      Float
  garageSpaces  Int           @default(0)
  yearBuilt     Int?

  address       String
  city          String
  state         String
  zipCode       String
  latitude      Float?
  longitude     Float?

  images        String[]
  videoTourUrl  String?
  amenities     String[]
  featured      Boolean       @default(false)
  viewsCount    Int           @default(0)
  rejectionReason String?     @db.Text

  // Seller Reference
  sellerId      String
  seller        User          @relation("SellerProperties", fields: [sellerId], references: [id], onDelete: Cascade)

  // Relations
  favorites     Favorite[]
  inquiries     Inquiry[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([city, price])
  @@index([propertyType, listingType, listingStatus])
  @@index([sellerId])
  @@index([featured])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// INQUIRY / LEAD MODEL
// ----------------------------------------------------

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  sellerId   String
  buyerId    String?

  buyerName  String
  buyerEmail String
  buyerPhone String?
  message    String        @db.Text
  tourDate   DateTime?
  tourTime   String?
  status     InquiryStatus @default(NEW)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller     User          @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer      User?         @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// FAVORITE MODEL
// ----------------------------------------------------

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ----------------------------------------------------
// NEXTAUTH MODELS
// ----------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
