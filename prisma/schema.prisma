// Production-Grade Prisma Schema for Multi-Role Real Estate Marketplace
// Database: PostgreSQL (Neon / Supabase / AWS RDS / Self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  BUYER
  SELLER
  AGENT
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  COMMERCIAL
  PLOT
  PENTHOUSE
}

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum ListingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SOLD
}

enum InquiryStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED
}

enum SavedSearchFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// ----------------------------------------------------
// USER MODEL
// ----------------------------------------------------

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  password       String?   // Hashed with bcrypt (cost 12)
  image          String?
  phone          String?
  whatsappNumber String?
  role           Role      @default(BUYER)
  isVerified     Boolean   @default(false)
  agencyName     String?
  bio            String?   @db.Text
  licenseNumber  String?

  // Relations
  properties          Property[]    @relation("SellerProperties")
  inquiries           Inquiry[]     @relation("BuyerInquiries")
  leads               Inquiry[]     @relation("SellerInquiries")
  favorites           Favorite[]
  savedSearches       SavedSearch[]

  // Chat Relations
  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  sentMessages        Message[]      @relation("SentMessages")

  // Reviews
  reviewsReceived     AgentReview[]  @relation("AgentReviews")
  reviewsAuthored     AgentReview[]  @relation("BuyerReviews")

  // Auth.js / NextAuth Support
  accounts       Account[]
  sessions       Session[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role, isVerified])
  @@index([email])
}

// ----------------------------------------------------
// PROPERTY MODEL
// ----------------------------------------------------

model Property {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @db.Text
  price           Float
  currency        String        @default("USD")
  propertyType    PropertyType
  listingType     ListingType
  listingStatus   ListingStatus @default(PENDING_APPROVAL)

  bedrooms        Int           @default(0)
  bathrooms       Int           @default(0)
  areaSqFt        Float
  garageSpaces    Int           @default(0)
  yearBuilt       Int?

  address         String
  city            String
  state           String
  zipCode         String
  latitude        Float?
  longitude       Float?

  images          String[]
  virtualTourUrl  String?
  videoTourUrl    String?
  amenities       String[]
  featured        Boolean       @default(false)
  viewsCount      Int           @default(0)
  rejectionReason String?       @db.Text

  // Seller Reference
  sellerId        String
  seller          User          @relation("SellerProperties", fields: [sellerId], references: [id], onDelete: Cascade)

  // Relations
  favorites       Favorite[]
  inquiries       Inquiry[]
  conversations   Conversation[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([city, price])
  @@index([propertyType, listingType, listingStatus])
  @@index([sellerId])
  @@index([featured])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// INQUIRY / LEAD MODEL
// ----------------------------------------------------

model Inquiry {
  id         String        @id @default(cuid())
  propertyId String
  sellerId   String
  buyerId    String?

  buyerName  String
  buyerEmail String
  buyerPhone String?
  message    String        @db.Text
  tourDate   DateTime?
  tourTime   String?
  status     InquiryStatus @default(NEW)

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seller     User          @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer      User?         @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------
// FAVORITE MODEL
// ----------------------------------------------------

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// ----------------------------------------------------
// LIVE CHAT SYSTEM
// ----------------------------------------------------

model Conversation {
  id         String    @id @default(cuid())
  propertyId String
  buyerId    String
  sellerId   String

  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer      User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller     User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages   Message[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([propertyId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([propertyId])
  @@index([updatedAt(sort: Desc)])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String       @db.Text
  isRead         Boolean      @default(false)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([senderId])
}

// ----------------------------------------------------
// SAVED SEARCH & EMAIL ALERTS
// ----------------------------------------------------

model SavedSearch {
  id             String               @id @default(cuid())
  userId         String
  name           String?
  queryCriteria  Json
  frequency      SavedSearchFrequency @default(INSTANT)
  lastNotifiedAt DateTime?

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([userId])
  @@index([frequency])
}

// ----------------------------------------------------
// AGENT / SELLER REVIEWS & RATINGS
// ----------------------------------------------------

model AgentReview {
  id          String   @id @default(cuid())
  agentId     String
  reviewerId  String
  rating      Int      // 1 to 5 stars
  comment     String   @db.Text
  isApproved  Boolean  @default(false)

  agent       User     @relation("AgentReviews", fields: [agentId], references: [id], onDelete: Cascade)
  reviewer    User     @relation("BuyerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId, isApproved])
  @@index([reviewerId])
}

// ----------------------------------------------------
// NEXTAUTH MODELS
// ----------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
